{
  "name": "@ryandotzone/wp-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the WordPress REST API, built for headless WordPress.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "wordpress",
    "wp-json",
    "rest-api",
    "headless",
    "typescript",
    "sdk"
  ],
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && bun run build:types && bun run check:dist",
    "build:esm": "bun build ./src/index.ts --target=node --packages=external --outdir=dist",
    "build:cjs": "bun build ./src/index.ts --target=node --packages=external --format=cjs --outfile=dist/index.cjs",
    "build:types": "bun scripts/build-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "bun run build",
    "check:dist": "bun scripts/check-dist.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanzbartlett/wordpress-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ryanzbartlett/wordpress-sdk/issues"
  },
  "homepage": "https://github.com/ryanzbartlett/wordpress-sdk#readme"
}